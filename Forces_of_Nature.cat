    <profile name="NATURE’S INFERNO" id="bc8e-cf87-e55f-633f" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">2</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">Use this ability when this model makes a Ranged attack with
Elemental Fire, before any dice are rolled.</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">Elemental Fire gains Piercing (1) for this attack.</characteristic>
      </characteristics>
    </profile>
    <profile name="Fire Elemental" id="04bc-9fb6-7a0c-3e5b" hidden="false" typeId="8146-3b99-e6f9-d0a1" typeName=" Warband Member">
      <characteristics>
        <characteristic name="Sp" typeId="cf71-9092-4511-812d">5</characteristic>
        <characteristic name="Me" typeId="2554-7056-7252-7cb0">5+</characteristic>
        <characteristic name="Ra" typeId="bc43-4f04-cc0b-d5a1">-</characteristic>
        <characteristic name="Ar" typeId="cbb8-58cf-daa7-a95a">4+</characteristic>
        <characteristic name="Ne" typeId="945e-25f3-67f4-228d">4+</characteristic>
        <characteristic name="Wn" typeId="0d6a-358f-3234-b66b">3</characteristic>
        <characteristic name="H" typeId="492c-c3ca-0905-99c9">3</characteristic>
        <characteristic name="Ranged" typeId="0a27-40ac-5701-ef13">-</characteristic>
