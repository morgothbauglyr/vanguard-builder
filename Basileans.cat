  <rules>
    <rule name="Iron Resolve (2)" id="765e-101e-046d-a0aa" hidden="false">
      <description>This ability may be used any number of times and at any time a Basilean model suffers 1 or more hits from an attack or spell. When the ability is used, the model can make all required Armour rolls for the attack at an unmodified 3+. Each model in the warband may only use this ability once per Round.</description>
    </rule>
  </rules>
