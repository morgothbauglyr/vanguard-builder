        <characteristic name="Rules" typeId="8b19-fa5a-3224-b8b5">Piercing (1), Area Effect (2”/1D8)</characteristic>
      </characteristics>
    </profile>
    <profile name="Celestial Screen" id="c47c-8581-9135-39da" hidden="false" typeId="33dc-fb92-76ea-f796" typeName="Spell">
      <characteristics>
        <characteristic name="Action" typeId="4e66-0225-3cc6-27c7">short</characteristic>
        <characteristic name="Range" typeId="c023-a997-9c10-c42c">6&quot;</characteristic>
        <characteristic name="Dice Roll" typeId="8297-1752-8ed2-7571"/>
        <characteristic name="Effect" typeId="1a53-41d9-8d96-a949">No dice roll required. Target a friendly model within range, even if they are Engaged. The model receives a +1 Ar bonus until the end of the Round (i.e. 6+ becomes 5+) to a maximum of 2+.</characteristic>
        <characteristic name="Rules" typeId="8b19-fa5a-3224-b8b5"/>
      </characteristics>
    </profile>
