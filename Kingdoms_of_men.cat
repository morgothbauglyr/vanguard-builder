    <profile name="Adrenaline Shot" id="1952-4024-bc65-1e62" hidden="false" typeId="33dc-fb92-76ea-f796" typeName="Spell">
      <characteristics>
        <characteristic name="Action" typeId="4e66-0225-3cc6-27c7">short</characteristic>
        <characteristic name="Range" typeId="c023-a997-9c10-c42c">9&quot;</characteristic>
        <characteristic name="Dice Roll" typeId="8297-1752-8ed2-7571">2D8</characteristic>
        <characteristic name="Effect" typeId="1a53-41d9-8d96-a949">Target a friendly model in range. For each hit scored, instead of causing damage, the target’s Ne and Ar stats are improved by 1 until the end of the Round.</characteristic>
        <characteristic name="Rules" typeId="8b19-fa5a-3224-b8b5"/>
        <characteristic name="Rules Boosted" typeId="ed87-4c1b-85df-b365"/>
      </characteristics>
    </profile>
    <profile name="Instill Courage" id="327b-c04f-04cb-b053" hidden="false" typeId="33dc-fb92-76ea-f796" typeName="Spell">
      <characteristics>
        <characteristic name="Action" typeId="4e66-0225-3cc6-27c7">short</characteristic>
        <characteristic name="Range" typeId="c023-a997-9c10-c42c">9&quot;</characteristic>
        <characteristic name="Dice Roll" typeId="8297-1752-8ed2-7571"/>
        <characteristic name="Effect" typeId="1a53-41d9-8d96-a949">No roll necessary. The target friendly model gains the Stubborn and Steady special rules until the end of the Round.</characteristic>
        <characteristic name="Rules" typeId="8b19-fa5a-3224-b8b5"/>
        <characteristic name="Rules Boosted" typeId="ed87-4c1b-85df-b365"/>
      </characteristics>
    </profile>
