  <sharedRules>
    <rule name="STRENGTH OF MEN (1)" id="cf8f-0754-d0bc-d940" hidden="false">
      <description>Spend power when any model in this warband fails a Nerve test to immediately allow them to re-roll that Nerve test. If they pass and are also within range of a model with Inspiring, they also gain Crushing Strength (1) (or add +1 to their value if they already have it) until the end of the round. Being in range of a model with Inspiring doesn’t grant a second re-roll.</description>
    </rule>
    <rule name="Spell - Instill Courage" id="3871-53bf-691a-3518" hidden="false">
      <description>No roll necessary. The target friendly model gains the Stubborn and Steady special rules until the end of the Round.</description>
    </rule>
    <rule name="Spell - Adrenaline Shot" id="49a0-7f9c-8dd1-5f0d" hidden="false">
      <description>Target a friendly model in range. For each hit scored, instead of causing damage, the target’s Ne and Ar stats are improved by 1 until the end of the Round.</description>
    </rule>
    <rule name="FOR THE KINGDOM! (1)" id="9456-6f8a-0f51-ca8f" hidden="false">
      <description>Use this ability at any time during one of yout Turns. All friendly, unengaged, standing Human models within 9” of this model make an immediate free Walk action. Models do not have to be moved. but if they do, it must be directly
towards the Leader of Men model following the normal movement rules. This move cannot be used to Engage enemy models.</description>
    </rule>
    <rule name="Devastating Charge" id="7fb9-65c2-b83b-92a6" hidden="false">
      <description>This model gain Crushing Strength (2) for any free Melee action it gets following a qualifying Charge action.</description>
    </rule>
    <rule name="Equipment - Large Shield" id="58db-b8e8-62fe-ccfe" hidden="false">
      <description>The model has the Defender special rule.</description>
    </rule>
  </sharedRules>
