    <profile name="STRENGTH OF MEN" id="e69f-7034-a1cf-4853" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">1</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">A model in this warband fails a Nerve test.</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">Immediately allow the model to re-roll that Nerve test. If they pass and are also within range of a model with Inspiring, they also gain Crushing Strength (1) (or add +1 to their value if they already have it) until the end of the round. Dice can only be re-rolled once.</characteristic>
      </characteristics>
    </profile>
    <profile name="FOR THE KINGDOM" id="4fd7-b343-a881-de8a" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">1</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">At any time during one of your Turns.</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">All friendly, unengaged, standing Human models within 9” of this model may make an immediate free Walk action directly towards this model following the normal movement rules. This move cannot be used to Engage enemy models.</characteristic>
      </characteristics>
    </profile>
    <profile name="EVER VIGILANT" id="5cc2-0e45-91f7-216b" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">3</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">An enemy model is activated within 12&quot; of this model.</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">Before the enemy model takes an action, select up to 2 friendly HUMAN models of the GRUNT or WARRIOR class. These models may perform a Walk action of up to 4&quot; following the normal movement rules.</characteristic>
      </characteristics>
    </profile>
