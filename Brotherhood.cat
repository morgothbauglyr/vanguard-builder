  <sharedRules>
    <rule name="Knightly Valour" id="38c5-5e8e-87b2-1e8b" hidden="false">
      <description>Only (Human, Knight) and SPELLCASTER models are considered for determining if the warband is broken. The warband is only broken when more than half the starting number of (Human, Knight) or SPELLCASTER models have been killed.</description>
    </rule>
    <rule name="Phalanx" id="e798-d975-8d5c-dbf3" hidden="false">
      <description>Use this ability when performing a Group Defence Action and selecting 3 Spearmen. If they are in base contact with at least one other of the 3 selected Spearmen at the end of the action, gain back 1 of the 2 power payed for Group Defence.</description>
    </rule>
    <rule name="Inspiring (Villeins Only)" id="e94f-6d40-54d2-9d8b" hidden="false" page="38" publicationId="8be5-5fc0-pubN68576"/>
  </sharedRules>
