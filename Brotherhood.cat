  <sharedRules>
    <rule name="Knightly Valour" id="38c5-5e8e-87b2-1e8b" hidden="false">
      <description>Only Human, Knight and SPELLCASTER models are considered for determining if the warband is broken. The warband is only broken when more than half the starting number of Human, Knight models have been killed.</description>
    </rule>
    <rule name="IMPETUOUS (2)" id="cdee-b860-81a3-cdad" hidden="false">
      <description>Use this ability in one of your Turns when you activate a COMMAND model. Until the end of the Round, all friendly Human, Knight models that start an activation within 6” of the COMMAND model add 2 to their Sp stat, to a maximum of Sp 10.</description>
    </rule>
    <rule name="Spell - Mist of Faith" id="2638-d43e-5a5e-e12e" hidden="false">
      <description>No dice roll required. Until the end of the Round, all Melee and Ranged attacks against friendly models within 6” of this spellcaster suffer a -1 modifier to hit.

Boosted Version: 

Cast as a long action instead. The modifier is increased to -2.</description>
    </rule>
    <rule name="Spell - Water’s Blessing" id="c8f4-aee8-113c-b693" hidden="false">
      <description>Target a single friendly model. If any successful hits are caused, that model gains the Pathfinder and Vicious special rules, and 1 bonus die for Melee attacks until the end of the Round.</description>
    </rule>
    <rule name="Combined Fire" id="16ce-3740-67c2-98e6" hidden="false">
      <description>When involved in a Group Shoot Action, Bowmen models add +1 Dice to their Ranged Attack roll if any other Villein Bowman model in the group fires at the same target.</description>
    </rule>
    <rule name="GROUP DEFENCE (1)" id="e798-d975-8d5c-dbf3" hidden="false">
      <description>When selecting 3 Villein Spearmen, if they are kept in base to base contact at the end of the action, Group Defence only costs them 1 power, instead of 2.</description>
    </rule>
    <rule name="EARTH SHAKING CHARGE (2)" id="3b63-7ce3-8167-fd61" hidden="false">
      <description>Use this ability when this model makes a qualifying Charge action. The enemy model that is Engaged must make a Nerve test with a -2 modifier. If it fails, it may not Retaliate against the subsequent Melee attack and is marked as Fatigued.</description>
    </rule>
    <rule name="LEAD BY EXAMPLE (2)" id="b971-9326-3e22-d689" hidden="false">
      <description>Use this ability when this model kills an enemy model iwith a Melee attack. All friendly Human, Knight models within 6” may remove any Fatigue counters they have.</description>
    </rule>
    <rule name="Inspiring (Villeins Only)" id="e94f-6d40-54d2-9d8b" hidden="false" page="38" publicationId="8be5-5fc0-pubN68576"/>
  </sharedRules>
