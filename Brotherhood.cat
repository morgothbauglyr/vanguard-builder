  <sharedProfiles>
    <profile name="IMPETUOUS" id="3a5b-49c1-117e-5b56" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">2</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">When you activate a COMMAND model.</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">Until the end of the Round, all friendly (Human, Knight) models that start an activation within 6” of the COMMAND model add 2 to their Sp stat, to a maximum of Sp 10.</characteristic>
      </characteristics>
    </profile>
    <profile name="Mist of Faith" id="dd56-8cb3-7e8d-5dd9" hidden="false" typeId="33dc-fb92-76ea-f796" typeName="Spell">
      <characteristics>
        <characteristic name="Action" typeId="4e66-0225-3cc6-27c7">short</characteristic>
        <characteristic name="Range" typeId="c023-a997-9c10-c42c">6&quot;</characteristic>
        <characteristic name="Dice Roll" typeId="8297-1752-8ed2-7571">-</characteristic>
        <characteristic name="Effect" typeId="1a53-41d9-8d96-a949">No dice roll required. Until the end of the Round, all Melee and Ranged attacks against friendly models within 6” of this spellcaster suffer a -1 modifier to hit.</characteristic>
        <characteristic name="Rules" typeId="8b19-fa5a-3224-b8b5"/>
      </characteristics>
    </profile>
