  <sharedRules>
    <rule name="Summoned Reaper" id="6a78-9766-f139-71dd" hidden="false">
      <description>While this model is in play, in the End phase of each Round, roll a die. On a result
of 1 or 2, the Reaper is removed from play.</description>
    </rule>
    <rule name="Whirlwind of Steel" id="0746-6214-0174-7e49" hidden="false">
      <description>Enemy models making a Melee attack against this model, even if it is knocked-down, suffer a -1 modifier when rolling to hit.</description>
    </rule>
    <rule name="Backstabber" id="bcbb-1408-d84b-a612" hidden="false">
      <description>While engaged with a target, as long as this model is in the target&apos;s rear arc, the target cannot retaliate.</description>
    </rule>
  </sharedRules>
