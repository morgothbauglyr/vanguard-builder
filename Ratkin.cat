  <sharedProfiles>
    <profile name="DISPLAY OF WEAKNESS" id="ba93-6967-4d2f-3e4d" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">2</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">At the start of a Turn.</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">Until the end of the Round, all models in the Warband of the race RATKIN gain Sneaky.</characteristic>
      </characteristics>
    </profile>
    <profile name="Vermin Swarm" id="80c8-c94a-75d1-85cb" hidden="false" typeId="33dc-fb92-76ea-f796" typeName="Spell">
      <characteristics>
        <characteristic name="Action" typeId="4e66-0225-3cc6-27c7">long</characteristic>
        <characteristic name="Range" typeId="c023-a997-9c10-c42c">6&quot;</characteristic>
        <characteristic name="Dice Roll" typeId="8297-1752-8ed2-7571"/>
        <characteristic name="Effect" typeId="1a53-41d9-8d96-a949">Cast on any friendly model (even if it is Engaged). May also be cast on self, even if caster is Engaged. Each enemy model Engaged by or Engaging the target must make an immediate
Fallback move of 3” following the normal rules. No Break Away tests are required. Knocked-down models are still moved and remain Knocked-down.</characteristic>
        <characteristic name="Rules" typeId="8b19-fa5a-3224-b8b5">Engaged Cast</characteristic>
      </characteristics>
    </profile>
    <profile name="Lair" id="f58e-a7f0-7515-7aca" hidden="false" typeId="33dc-fb92-76ea-f796" typeName="Spell">
      <characteristics>
        <characteristic name="Action" typeId="4e66-0225-3cc6-27c7">long</characteristic>
        <characteristic name="Range" typeId="c023-a997-9c10-c42c">6&quot;</characteristic>
        <characteristic name="Dice Roll" typeId="8297-1752-8ed2-7571"/>
        <characteristic name="Effect" typeId="1a53-41d9-8d96-a949">Instead of rolling to hit and wound as normal, every eligible target of the Breath attack must roll a D8 and add their Sp value. If the result is 8 or less, or a natural 1 was rolled, the model loses one wound with no Armour Roll possible.</characteristic>
        <characteristic name="Rules" typeId="8b19-fa5a-3224-b8b5">Breath</characteristic>
      </characteristics>
    </profile>
    <profile name="Blight Cannon" id="393c-5bb2-d048-8c24" hidden="false" typeId="3cda-8938-b7d6-58ab" typeName="Attack - Ranged">
      <characteristics>
        <characteristic name="Range" typeId="41f5-319f-6ccd-eaec">12&quot;</characteristic>
        <characteristic name="Dice" typeId="2088-497d-b499-8476">3D8</characteristic>
        <characteristic name="Rules" typeId="b478-b971-cc61-444f">Piercing (1)</characteristic>
      </characteristics>
    </profile>
    <profile name="INSANE POWER SURGE" id="8f05-831d-5c54-284c" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">X</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">Use this ability when this model is activated during one of your Turns.</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">Declare how much power is being spent before casting any spells. For each power spent, the warlock can cast one of the spells it knows regardless of the action length. Spells can only be boosted if it costs additional power to do so. Resolve the effects of each spell before casting the next. Once all spells are cast, the Warlock is marked as both Activated and Fatigued and roll 1d8 for each spell that was cast. For each 6+ rolled, the Warlock suffers 1 automatic wound with no armour save possible.</characteristic>
      </characteristics>
    </profile>
