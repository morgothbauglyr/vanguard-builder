    <profile name="BOUNTY" id="ea64-77d6-d2f8-6a64" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">2</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">Once per game, as a long action.</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">Mark an enemy model within 12” and in Line of Sight with a Bounty token. For the remainder of the game all friendly OGRE models may add +1 die to any Melee attacks against enemy models with one or more Bounty Tokens.</characteristic>
      </characteristics>
    </profile>
