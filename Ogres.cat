  <rules>
    <rule name="Warband - Special Validation Rules" id="bf6f-50e4-70a7-2e3d" hidden="false">
      <description>Battlescribe will take into account the additional validation rules imposed by the &apos;High &amp; Mighty&apos; war band rule with 1 exception - it will allow you to take an additional Support AND Spellcaster while the rules state OR (so only 1 additional figure is allowed).  Please play fair and make sure you do not validate this rule.</description>
    </rule>
  </rules>
