    <profile name="POINT BLANK" id="acf0-826e-e88f-eb94" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">1</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">Before making a Melee attack against an enemy model</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">The Boomer Sergeant may use its Sawn-Off Ranged attack from the facing in which the enemy model is Engaged. Note that it cannot also gain a bonus die for a qualifying Charge. This counts as a Ranged attack.</characteristic>
      </characteristics>
    </profile>
