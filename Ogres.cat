  <sharedProfiles>
    <profile name="TRIBAL DEFIANCE" id="285d-0abd-b2d6-1804" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">2</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">Any time during one of your activations</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">Until the end of the Round, all friendly OGRE models gain one free bonus die each time they make an Armour roll in response to a Melee or Ranged attack.</characteristic>
      </characteristics>
    </profile>
    <profile name="Battle Fury" id="f489-bf45-d213-3316" hidden="false" typeId="33dc-fb92-76ea-f796" typeName="Spell">
      <characteristics>
        <characteristic name="Action" typeId="4e66-0225-3cc6-27c7">long</characteristic>
        <characteristic name="Range" typeId="c023-a997-9c10-c42c">9&quot;</characteristic>
        <characteristic name="Dice Roll" typeId="8297-1752-8ed2-7571">2D8</characteristic>
        <characteristic name="Effect" typeId="1a53-41d9-8d96-a949">Target an Engaged friendly model that is not Knocked-down. If any hits are scored, that model may immediately make a Melee action for free against any one model it is Engaged with, even if it is already Activated and/or Fatigued.</characteristic>
        <characteristic name="Rules" typeId="8b19-fa5a-3224-b8b5"/>
      </characteristics>
    </profile>
    <profile name="Red Goblin" id="977e-afe5-c505-9494" hidden="false" typeId="8146-3b99-e6f9-d0a1" typeName=" Warband Member">
      <characteristics>
        <characteristic name="Sp" typeId="cf71-9092-4511-812d">5</characteristic>
