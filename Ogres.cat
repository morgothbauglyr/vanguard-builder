    <profile name="HERE YOU GO BOSS" id="01df-9b8e-9e6d-2144" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">1</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">Use at any time while this model is unactivated, standing, un-Engaged and within 3” of a friendly OGRE model.</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">Mark the RED GOBLIN as Activated. The OGRE gains one of the following rules for the remainder of the current Turn: 6th Sense, Marksman, Vicious, Regenerate (5+).</characteristic>
      </characteristics>
    </profile>
