        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">When the Ogre Sergeant attacks a model in Melee.</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">That model cannot Retaliate against any Melee attacks made by the Ogre Sergeant this Turn.</characteristic>
      </characteristics>
    </profile>
