    <profile name="TACTICAL REDEPLOYMENT" id="5f7d-45fe-651c-8ced" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">2</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">At any time during your turns.</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">Select a DWARF COMMAND model in the warband. All DWARF models within 9&quot;, including the nominated COMMAND model that are not knocked-down or Engaged, may immediately move up to 3&quot; in any direction, following the normal movement rules. Models are not marked as activated after moving if they are not already. Once any moves are completed, all models that were eligible to move are given a free Brace action (mark them all as such).</characteristic>
      </characteristics>
    </profile>
    <profile name="TREMOR STOMP" id="a15f-69a4-7205-29bb" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697"/>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">During this model&apos;s activation.</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">Use a short action during this model&apos;s activation to create a Shockwave. The model may be engaged.
All models (including friendly ones) of up to Height 2 within 3” of the model are moved 3” directly away from it. Movement will only be blocked by Impassable Terrain or other models not affected by the Shockwave. Move the models furthest away first. Models cannot become Engaged when moved by Shockwave – halt them 1” away if they would be. Models already Engaged will still end up Engaged with each other if both are moved.</characteristic>
      </characteristics>
    </profile>
    <profile name="Light Cannon" id="afbc-fc3e-fef3-38da" hidden="false" typeId="3cda-8938-b7d6-58ab" typeName="Attack - Ranged">
      <characteristics>
        <characteristic name="Range" typeId="41f5-319f-6ccd-eaec">12&quot;</characteristic>
        <characteristic name="Dice" typeId="2088-497d-b499-8476"/>
        <characteristic name="Rules" typeId="b478-b971-cc61-444f">Piercing (2)</characteristic>
      </characteristics>
    </profile>
    <profile name="Throwing Mastiff" id="1adb-9d0c-6d5f-fb57" hidden="false" typeId="3cda-8938-b7d6-58ab" typeName="Attack - Ranged">
      <characteristics>
        <characteristic name="Range" typeId="41f5-319f-6ccd-eaec">9&quot;</characteristic>
        <characteristic name="Dice" typeId="2088-497d-b499-8476">3D8</characteristic>
        <characteristic name="Rules" typeId="b478-b971-cc61-444f">3D8, Piercing (1), Reload</characteristic>
      </characteristics>
    </profile>
    <profile name="Forged Anew" id="346e-1dab-4a8a-3774" hidden="false" typeId="33dc-fb92-76ea-f796" typeName="Spell">
      <characteristics>
        <characteristic name="Action" typeId="4e66-0225-3cc6-27c7">short</characteristic>
        <characteristic name="Range" typeId="c023-a997-9c10-c42c">6&quot;</characteristic>
        <characteristic name="Dice Roll" typeId="8297-1752-8ed2-7571">2D8</characteristic>
        <characteristic name="Effect" typeId="1a53-41d9-8d96-a949">Cast on self or target a single friendly model within range, even if it is Engaged. Roll 2D8. For each 7+ rolled, the Ar stat of the target is improved by 1 until the end of the Round. (e.g. 5+ becomes 4+), to a maximum of 3+.</characteristic>
        <characteristic name="Rules" typeId="8b19-fa5a-3224-b8b5"/>
      </characteristics>
    </profile>
    <profile name="Earthquake" id="8c67-3dc8-036f-ea6f" hidden="false" typeId="33dc-fb92-76ea-f796" typeName="Spell">
      <characteristics>
        <characteristic name="Action" typeId="4e66-0225-3cc6-27c7">long</characteristic>
        <characteristic name="Range" typeId="c023-a997-9c10-c42c">6&quot;</characteristic>
        <characteristic name="Dice Roll" typeId="8297-1752-8ed2-7571"/>
        <characteristic name="Effect" typeId="1a53-41d9-8d96-a949">Each model under the area of the Breath attack must roll a die. If a model rolls equal to or under its Sp stat, it is Knocked-down and must make a single Armour Roll to avoid suffering a wound. Models that have the Steady special rule may re-roll the test against their Sp stat.</characteristic>
        <characteristic name="Rules" typeId="8b19-fa5a-3224-b8b5">Breath</characteristic>
      </characteristics>
    </profile>
    <profile name="Dwarf Flame Thrower" id="9115-8aae-5804-2498" hidden="false" typeId="3cda-8938-b7d6-58ab" typeName="Attack - Ranged">
      <characteristics>
        <characteristic name="Range" typeId="41f5-319f-6ccd-eaec">6&quot;</characteristic>
        <characteristic name="Dice" typeId="2088-497d-b499-8476">4D8</characteristic>
        <characteristic name="Rules" typeId="b478-b971-cc61-444f">Breath, Piercing (1)</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
  <sharedRules>
    <rule name="Spell - Earthquake" id="f5ff-97ee-4d00-5dbd" hidden="false">
      <description>Each model under the area of the Breath attack must roll a die. If a model rolls equal to or under its Sp stat, it is Knocked-down and must make a single Armour Roll to avoid suffering a wound. Models that have the Steady special rule may re-roll the test against their Sp stat.</description>
    </rule>
    <rule name="Spell - Forged Anew" id="ee51-cc1f-7424-01ed" hidden="false">
      <description>Cast on self or target a single friendly model within range, even if it is Engaged. Roll 3D8. For each 7+ rolled, the Ar stat of the target is improved by 1 until the end of the Round. (e.g. 5+ becomes 4+), to a maximum of 3+.</description>
    </rule>
    <rule name="Shieldbreaker Hammer" id="df56-154a-31a4-ba5b" hidden="false">
      <description>The model may reroll one of its Melee attack dice that failed to cause a hit.</description>
    </rule>
    <rule name="Battledrill" id="b0f8-686f-9124-0d75" hidden="false">
      <description>When this model makes a Melee attack (not a Retaliation) with the Battledrill, hits are scored on a 5+ regardless of any modifiers. Every hit scored counts as an exploding 8 result and so another die can be rolled.</description>
    </rule>
    <rule name="Hammer and Anvil" id="16e1-5b86-4dfd-4a49" hidden="false">
      <description>Ironclad models Engaged with the same enemy model as one or more friendly Shieldbreakers, have the Swarm special rule.</description>
    </rule>
    <rule name="Concentrated Fire" id="8be9-95c7-8650-21b7" hidden="false">
      <description>Once per game, the Flame Priest can take a long action to attack using its Dwarf Flame Thrower with Range 9” and Piercing (2), instead of the normal profile. This will also Fatigue the Flame Priest.</description>
    </rule>
    <rule name="Bullheaded" id="3270-2e91-2529-bee7" hidden="false">
      <description>DWARF models in this warband add +1 to the result when rolling for Headstrong. This means that on a 5+, the Fatigue counter is removed and the model may act as normal.</description>
    </rule>
  </sharedRules>
