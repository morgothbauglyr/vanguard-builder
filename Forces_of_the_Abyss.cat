      </characteristics>
    </profile>
    <profile name="Immolation" id="a40c-5fdd-92aa-a823" hidden="false" typeId="33dc-fb92-76ea-f796" typeName="Spell">
      <characteristics>
        <characteristic name="Action" typeId="4e66-0225-3cc6-27c7">long</characteristic>
        <characteristic name="Range" typeId="c023-a997-9c10-c42c">6&quot;</characteristic>
        <characteristic name="Dice Roll" typeId="8297-1752-8ed2-7571"/>
        <characteristic name="Effect" typeId="1a53-41d9-8d96-a949">No dice roll is required to hit the target. The target suffers 1 automatic hit. If a wound is caused, the target suffers another automatic hit as the flames continue to burn. Repeat this process until the target is either dead or the flames are put out by a successful Armour roll.</characteristic>
        <characteristic name="Rules" typeId="8b19-fa5a-3224-b8b5"/>
        <characteristic name="Rules Boosted" typeId="ed87-4c1b-85df-b365"/>
      </characteristics>
    </profile>
    <profile name="Torment" id="31d5-848a-5e09-c81c" hidden="false" typeId="33dc-fb92-76ea-f796" typeName="Spell">
      <characteristics>
        <characteristic name="Action" typeId="4e66-0225-3cc6-27c7">short</characteristic>
        <characteristic name="Range" typeId="c023-a997-9c10-c42c">6&quot;</characteristic>
        <characteristic name="Dice Roll" typeId="8297-1752-8ed2-7571"/>
        <characteristic name="Effect" typeId="1a53-41d9-8d96-a949">No dice roll is required to hit the target. The target must make 2 Nerve tests. For each test that is failed, the target suffers a wound with no Armour roll possible.</characteristic>
        <characteristic name="Rules" typeId="8b19-fa5a-3224-b8b5"/>
        <characteristic name="Rules Boosted" typeId="ed87-4c1b-85df-b365"/>
      </characteristics>
    </profile>
