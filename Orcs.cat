  <sharedProfiles>
    <profile name="GREEN TIDE" id="d768-1d48-c98d-0232" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">2</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">Group Charge Action.</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">Until the end of the Turn, all members of the group of type ORC gain Crushing Strength (1) or increase their Crushing Strength by one if they already have this special rule.</characteristic>
      </characteristics>
    </profile>
