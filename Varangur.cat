      <profiles>
        <profile name="Shattering Blow" id="96b7-d794-43ce-9408" hidden="false" typeId="33dc-fb92-76ea-f796" typeName="Spell">
          <characteristics>
            <characteristic name="Action" typeId="4e66-0225-3cc6-27c7">long</characteristic>
            <characteristic name="Range" typeId="c023-a997-9c10-c42c">6&quot;</characteristic>
            <characteristic name="Dice Roll" typeId="8297-1752-8ed2-7571">1D8</characteristic>
            <characteristic name="Effect" typeId="1a53-41d9-8d96-a949">If a hit is scored, instead of causing a wound, the target must instead roll a die. If they roll under their Ar stat (excluding Brace), it is permenently increased (gets  worse) for the remainder of the game (e.g. 5+ become 6+). A model can be affected by this multiple times.</characteristic>
            <characteristic name="Rules" typeId="8b19-fa5a-3224-b8b5"/>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
