        <characteristic name="Melee" typeId="01d6-153a-0767-f01e">4D8</characteristic>
        <characteristic name="Base" typeId="b790-5251-7057-2f74">Heavy Infantry</characteristic>
      </characteristics>
    </profile>
    <profile name="EVASIVE MANOUVRES" id="e24b-7b72-a53f-dd33" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">2</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">A a Group Action. Spend the Power to nominate this model as the group leader and the group and activate them together.</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">The group members each make a Run action with +1 Sp and gain the Dodge special rule until the end of the Round. Group members can only be of classes COMMAND, WARRIOR or GRUNT. The Run cannot be used to Engage enemy models.
All group members must finish their movement within 6” of each other.</characteristic>
      </characteristics>
    </profile>
    <profile name="SLAMBACK" id="5170-f1ea-e295-cb7e" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">1</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">when this model Retaliates before dice arerolled.</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">Any hits this Retaliation scores are resolved with an additional+1 Crushing Strength.</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
  <sharedRules>
    <rule name="Blazing Brands" id="a7aa-6bbd-9d27-6f54" hidden="false">
      <description>While Firebrand is part of the same warband, this model has the Stubborn special rule.</description>
    </rule>
    <rule name="Riposte" id="0192-ff68-06dc-c8f2" hidden="false">
      <description>When this model is the target of a Melee attack and all the attacker’s dice miss, this model may make a Retaliation for free. No Activated or Fatigued counter is placed on this model after a Riposte.</description>
    </rule>
    <rule name="Fancy Swordplay" id="94bd-cfc3-53b9-b61a" hidden="false">
      <description>Melee attacks against this model are made with a -1 modifier to the attackers Me stat.</description>
    </rule>
    <rule name="Salamander Legend" id="1131-ad33-a947-c46b" hidden="false">
      <description>When taken in a Salamander warband, Firebrand is not considered a Mercenary. She does count as being at Rank 5 to match her legendary status however.</description>
    </rule>
    <rule name="Elemental Fuel" id="34d6-4f22-1438-3f01" hidden="false">
      <description>While within 6” of one or more friendly Fire Elementals, this model’s Special Abilities cost 1 less Power to use.</description>
    </rule>
    <rule name="Rekindle the Embers" id="3429-95d3-0f47-64ca" hidden="false">
      <description>While within 6” of a friendly Fire Elemental or Mage Priest, this model has the Bloodlust special rule.</description>
    </rule>
    <rule name="Brothers in Arms" id="0007-21d3-a56c-c645" hidden="false">
      <description>This model gains +1 die in Melee while it is a member of a Shield Wall group action.</description>
    </rule>
    <rule name="Inspiring (Ghekkotah only)" id="a8e2-751f-d827-31c6" hidden="false">
      <description>A model with this rule, and all friendly models within 6” of it, may re-roll failed Nerve tests.</description>
    </rule>
    <rule name="Simmering Rage" id="209b-acdf-a3de-0bfd" hidden="false">
      <description>For each wound the Tyrant has suffered, increase the Tyrant’s Crushing Strength by +1.</description>
    </rule>
    <rule name="Building Inferno" id="e37c-1d4d-627b-46e9" hidden="false">
      <description>This Warband may carry over up to 3 unused Power to the next Round, instead of losing any unspent as normal. For example, if the Warband ended a Round with 2 Power left, the Warband could add 2 to the total Power rolled in the next Round.</description>
    </rule>
    <rule name="Efficient Command" id="8b5d-02b7-c103-7429" hidden="false">
      <description>Standard Group Actions (from the rulebook) cost 1 less Power if the nominated group leader is a SALAMANDERS COMMAND model. This does not affect Group Actions from card abilities.</description>
    </rule>
  </sharedRules>
