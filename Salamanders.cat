    <profile name="Battle-Captain" id="ca28-f0b9-7d39-2013" hidden="false" typeId="8146-3b99-e6f9-d0a1" typeName=" Warband Member">
      <characteristics>
        <characteristic name="Sp" typeId="cf71-9092-4511-812d">5</characteristic>
