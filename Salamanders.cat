    <profile name="ORDEAL OF FIRE" id="357d-7c14-7665-ae18" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">2</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">During this model’s activation, before or after an action, even if it is Engaged or Knocked-down.</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">Models of type SALAMANDER (including the Veteran itself) and Fire Elementals are immune to the effects of this attack. All other models within 2” take 2 automatic hits with Piercing (1). Make Armour rolls as normal. This ability can only be used once per game.</characteristic>
      </characteristics>
    </profile>
