    <profile name="SHIELD WALL" id="2c1b-7f2a-05cd-8231" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">2</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">As a Group Action.</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">This ability works like the standard Group Assault, except this model must be the group leader, and the group members can only consist of COMMAND, WARRIOR and SUPPORT models. In addition, enemy models retaliating against Melee attacks from this Group Assault, suffer a -2 to-hit modifier.</characteristic>
      </characteristics>
    </profile>
    <profile name="Mage-Priest" id="dbf2-c4bb-6e94-4f99" hidden="false" typeId="8146-3b99-e6f9-d0a1" typeName=" Warband Member">
      <characteristics>
        <characteristic name="Sp" typeId="cf71-9092-4511-812d">5</characteristic>
        <characteristic name="Me" typeId="2554-7056-7252-7cb0">5+</characteristic>
        <characteristic name="Ra" typeId="bc43-4f04-cc0b-d5a1">4+</characteristic>
        <characteristic name="Ar" typeId="cbb8-58cf-daa7-a95a">6+</characteristic>
        <characteristic name="Ne" typeId="945e-25f3-67f4-228d">4+</characteristic>
        <characteristic name="Wn" typeId="0d6a-358f-3234-b66b">3</characteristic>
        <characteristic name="H" typeId="492c-c3ca-0905-99c9">2</characteristic>
        <characteristic name="Ranged" typeId="0a27-40ac-5701-ef13">2D8</characteristic>
        <characteristic name="Melee" typeId="01d6-153a-0767-f01e">1D8</characteristic>
        <characteristic name="Base" typeId="b790-5251-7057-2f74">25mm</characteristic>
      </characteristics>
    </profile>
    <profile name="HEALING FLAME" id="630d-7214-64ef-df1c" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">3</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">As a long action.</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">Roll a die for each friendly model within 6”. On a score of 6+, that model regains a wound previously suffered.</characteristic>
      </characteristics>
    </profile>
    <profile name="INNER FIRE" id="a431-40dd-4368-55aa" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">2</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">When this model activates.</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">The model’s Armour improves by 2 until the end of the Round (i.e. 6+ becomes 4+) to no better than 3+.</characteristic>
      </characteristics>
    </profile>
    <profile name="Firebrand" id="4c79-84da-ab7d-ae02" hidden="false" typeId="8146-3b99-e6f9-d0a1" typeName=" Warband Member">
      <characteristics>
