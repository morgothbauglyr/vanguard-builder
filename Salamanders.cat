    <profile name="GUN SMOKE" id="3ab2-cf2a-d2a3-21f5" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">1</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">When this model attacks with a pistol, before dice are rolled.</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">This model gains the Stealthy and Dodge special rules until the end of the Round,
regardless of whether the attack hits.</characteristic>
      </characteristics>
    </profile>
