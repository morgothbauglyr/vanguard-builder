        <characteristic name="Base" typeId="b790-5251-7057-2f74">Monster</characteristic>
      </characteristics>
    </profile>
    <profile name="LEAP OF DEATH" id="871c-8a0d-744d-3efd" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697"/>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">When declaring a Run action with this model that does not Engage.</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">This model gains the Fly special rule until the end of the Turn. At the end of this Run, this model may make a free Ranged attack: Range 6”, Breath, Piercing (1), from each of its front and rear base edges.</characteristic>
      </characteristics>
    </profile>
    <profile name="Lekelidon" id="d1e4-87c9-b303-6e79" hidden="false" typeId="8146-3b99-e6f9-d0a1" typeName=" Warband Member">
      <characteristics>
        <characteristic name="Sp" typeId="cf71-9092-4511-812d">6</characteristic>
