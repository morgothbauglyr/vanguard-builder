  <sharedProfiles>
    <profile name="KTHORLAQ’S HAND" id="c663-0ffd-7317-92c2" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">1</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">any time a model of type SALAMANDER rolls to hit with either a Melee or Ranged attack.</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">After re-rolling any dice from other sources, Spend the Power to reroll a single die that failed to hit. As normal however, you cannot re-roll a re-roll.</characteristic>
      </characteristics>
    </profile>
    <profile name="Feel the Burn" id="ecb3-c645-06ab-c6b5" hidden="false" typeId="33dc-fb92-76ea-f796" typeName="Spell">
      <characteristics>
        <characteristic name="Action" typeId="4e66-0225-3cc6-27c7">short</characteristic>
        <characteristic name="Range" typeId="c023-a997-9c10-c42c">9&quot;</characteristic>
        <characteristic name="Dice Roll" typeId="8297-1752-8ed2-7571">2D8</characteristic>
        <characteristic name="Effect" typeId="1a53-41d9-8d96-a949">Cast on a single friendly model of type SALAMANDER within range, even if it is Engaged. Roll 2D8 to hit with a -2 modifier. If any hits are scored, instead of damage the target gains Crushing Strength (2) or modifies its Crushing Strength by +2 until the end of the Round.</characteristic>
        <characteristic name="Rules" typeId="8b19-fa5a-3224-b8b5">Crushing Strength (2)</characteristic>
      </characteristics>
    </profile>
    <profile name="Shimmer" id="44a4-47fd-ce55-1e4f" hidden="false" typeId="33dc-fb92-76ea-f796" typeName="Spell">
      <characteristics>
        <characteristic name="Action" typeId="4e66-0225-3cc6-27c7">long</characteristic>
        <characteristic name="Range" typeId="c023-a997-9c10-c42c">9&quot;</characteristic>
        <characteristic name="Dice Roll" typeId="8297-1752-8ed2-7571">-</characteristic>
        <characteristic name="Effect" typeId="1a53-41d9-8d96-a949">Enemy models targeting the caster, or friendly models that are within 9” of the caster, suffer a -1 modifier to hit with all attacks. This lasts until the end of the Round. Place a spell effect marker on the casting model as a reminder.</characteristic>
        <characteristic name="Rules" typeId="8b19-fa5a-3224-b8b5"/>
      </characteristics>
    </profile>
