    </profile>
    <profile name="SAVAGE ROAR" id="cc65-7633-907a-bdc4" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">2</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">When the Tyrant is the target of a Melee attack, before the attack roll is made.</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">The attacking model reduces its Crushing Strength by 1, to a minimum of 0 for that attack.</characteristic>
      </characteristics>
    </profile>
    <profile name="SAVAGE IMPACT" id="9a76-f299-4d22-ff54" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">1</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">Before a qualifying Charge action.</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">If any wounds are caused by this model in the subsequent free Melee attack and it is not killed, the target is pushed directly backwards 3”, stopping if it hits any
terrain, objectives or other models. The Rhinosaur Cataphract may then choose to move forwards back into base contact to remain Engaged.</characteristic>
      </characteristics>
    </profile>
    <profile name="Rhinosaur Caraphract" id="98e2-f6ed-2295-679d" hidden="false" typeId="8146-3b99-e6f9-d0a1" typeName=" Warband Member">
      <characteristics>
        <characteristic name="Sp" typeId="cf71-9092-4511-812d">5</characteristic>
        <characteristic name="Me" typeId="2554-7056-7252-7cb0">4+</characteristic>
        <characteristic name="Ra" typeId="bc43-4f04-cc0b-d5a1">7+</characteristic>
        <characteristic name="Ar" typeId="cbb8-58cf-daa7-a95a">4+</characteristic>
        <characteristic name="Ne" typeId="945e-25f3-67f4-228d">4+</characteristic>
