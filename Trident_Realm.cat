        <characteristic name="Base" typeId="b790-5251-7057-2f74">Heavy Infantry</characteristic>
      </characteristics>
    </profile>
    <profile name="Naiad Envoy" id="54be-b678-a4ee-f4e5" hidden="false" typeId="8146-3b99-e6f9-d0a1" typeName=" Warband Member">
      <characteristics>
        <characteristic name="Sp" typeId="cf71-9092-4511-812d">6</characteristic>
        <characteristic name="Me" typeId="2554-7056-7252-7cb0">5+</characteristic>
