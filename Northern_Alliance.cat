    <profile name="Hold Fast" id="fa24-60c0-7b61-3b45" hidden="false" typeId="33dc-fb92-76ea-f796" typeName="Spell">
      <characteristics>
        <characteristic name="Action" typeId="4e66-0225-3cc6-27c7">short</characteristic>
        <characteristic name="Range" typeId="c023-a997-9c10-c42c">9&quot;</characteristic>
        <characteristic name="Dice Roll" typeId="8297-1752-8ed2-7571"/>
        <characteristic name="Effect" typeId="1a53-41d9-8d96-a949">Target a friendly model, even if it is Engaged. For the remainder of the Round, that model has a +1 modifier to any Nerve tests it is required to make and may add 1 bonus die to any Armour rolls it must take.</characteristic>
        <characteristic name="Rules" typeId="8b19-fa5a-3224-b8b5"/>
      </characteristics>
    </profile>
    <profile name="Hold Fast (Boosted)" id="ae04-a52c-f06c-adc6" hidden="false" typeId="33dc-fb92-76ea-f796" typeName="Spell">
      <characteristics>
        <characteristic name="Action" typeId="4e66-0225-3cc6-27c7">long</characteristic>
        <characteristic name="Range" typeId="c023-a997-9c10-c42c">9&quot;</characteristic>
        <characteristic name="Dice Roll" typeId="8297-1752-8ed2-7571"/>
        <characteristic name="Effect" typeId="1a53-41d9-8d96-a949">Target a friendly model, even if it is Engaged. For the remainder of the Round, that model has a +2 modifier to any Nerve tests it is required to make and may add 2 bonus die to any Armour rolls it must take.</characteristic>
        <characteristic name="Rules" typeId="8b19-fa5a-3224-b8b5"/>
      </characteristics>
    </profile>
    <profile name="Icy Breath" id="ed58-6f28-0b45-a276" hidden="false" typeId="3cda-8938-b7d6-58ab" typeName="Attack - Ranged">
      <characteristics>
        <characteristic name="Range" typeId="41f5-319f-6ccd-eaec">9&quot;</characteristic>
        <characteristic name="Dice" typeId="2088-497d-b499-8476">3D8</characteristic>
        <characteristic name="Rules" typeId="b478-b971-cc61-444f">Power Cost (2), Breath, Piercing (1)</characteristic>
      </characteristics>
    </profile>
    <profile name="Winter’s Bite" id="c726-bf12-df2a-2992" hidden="false" typeId="33dc-fb92-76ea-f796" typeName="Spell">
      <characteristics>
        <characteristic name="Action" typeId="4e66-0225-3cc6-27c7">long</characteristic>
        <characteristic name="Range" typeId="c023-a997-9c10-c42c">12&quot;</characteristic>
        <characteristic name="Dice Roll" typeId="8297-1752-8ed2-7571">3D8</characteristic>
        <characteristic name="Effect" typeId="1a53-41d9-8d96-a949">If the target suffers any wounds, it is Knocked-down and marked as Fatigued.</characteristic>
        <characteristic name="Rules" typeId="8b19-fa5a-3224-b8b5"/>
      </characteristics>
    </profile>
    <profile name="HARDY VETERANS" id="aeb2-16eb-3c7f-466d" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">1</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">When a model would be knocked down.</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">Gain the Steady ability for this attack. Models that already have Steady may re-roll the result. This ability may be used any number of time in a Round.</characteristic>
      </characteristics>
    </profile>
    <profile name="HEAD SWING" id="d344-10b4-d6ad-75d5" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">1</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">Use this ability when making a Melee attack (not a Retaliate) instead of rolling to hit as normal.</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">Every enemy model that is Engaged with this model must make a Nerve test with a -1 Modifier. If any model fails its test, it is knocked-down and marked as Fatigued. Once all models have made a test, the Melee attack ends. Models may Retaliate if permitted to do so as normal.</characteristic>
      </characteristics>
    </profile>
    <profile name="ICE BLAST" id="a2a1-c385-7bfa-3667" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">1</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">When a model is knocked down by this model in Melee.</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">The model must take a Nerve test. If the test is failed, the model is marked as Fatigued.</characteristic>
      </characteristics>
    </profile>
    <profile name="LASH" id="c7a1-3b94-8775-888d" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">1</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">Use this ability when casting the Lightning Bolt spell.</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">Lightning Bolt becomes a short action to cast instead of a long action.</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
  <sharedRules>
    <rule name="Frost Hammer" id="79a0-5d5c-4b24-84a8" hidden="false">
      <description>A great two-handed hammer wielded by the Dwarf clans in the North. The model gains Crushing Strength (1) and reduces it&apos;s Ar by 1.</description>
    </rule>
    <rule name="Talannar’s Pack" id="c0ca-1849-6fe6-9e5e" hidden="false">
      <description>Northern Alliance Warbands may take 1 additional LARGE model than the game size would normally allow.</description>
    </rule>
  </sharedRules>
