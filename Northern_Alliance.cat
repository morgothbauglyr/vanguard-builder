<catalogue name="Northern Alliance" id="257e-724d-d140-2297" authorContact="therealbitpsycho@gmail.com" authorName="BitPsycho" battleScribeVersion="2.03" gameSystemId="37f5-f8f9-2ecf-9c36" gameSystemRevision="1" library="false" revision="9" type="catalogue" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <publications>
    <publication name="Rulebook" id="ffea-0323-pubN70796"/>
  </publications>
  <rules>
    <rule name="HARDY VETERANS (1)" id="6bfa-4e8a-573d-8ca9" hidden="false">
      <description>Use this ability when a model would be knocked down, Spend 1 power to gain the Steady ability for this attack. Models that already have Steady may re-roll the result. This ability may be used any number of time in a Round.</description>
    </rule>
    <rule name="Talannar’s Pack" id="c0ca-1849-6fe6-9e5e" hidden="false">
      <description>Northern Alliance Warbands may take 1 additional LARGE model than the game size would normally allow.</description>
    </rule>
  </rules>
