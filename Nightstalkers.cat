      <costs>
        <cost name=" Points" typeId="b888-e3bd-8798-6364" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Piercing (1)" id="9dd1-51e6-73ff-4291" hidden="false" targetId="c368-af1a-68cf-2b9b" type="rule"/>
      </infoLinks>
      <profiles>
