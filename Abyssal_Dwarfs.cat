      </characteristics>
    </profile>
    <profile name="GIFT OF IMMORATLITY" id="3c6b-3da0-684b-a0ac" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">1</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">At any time.</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">Re-roll any one die rolled by this model.</characteristic>
      </characteristics>
    </profile>
    <profile name="Immortal Guardian" id="4f44-90b2-4868-fdc9" hidden="false" typeId="8146-3b99-e6f9-d0a1" typeName=" Warband Member">
