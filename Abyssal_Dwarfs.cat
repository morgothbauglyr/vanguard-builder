      </characteristics>
    </profile>
    <profile name="Ratkin Slave" id="4daa-4d86-58a6-12e9" hidden="false" typeId="8146-3b99-e6f9-d0a1" typeName=" Warband Member">
      <characteristics>
        <characteristic name="Sp" typeId="cf71-9092-4511-812d">6</characteristic>
        <characteristic name="Me" typeId="2554-7056-7252-7cb0">7+</characteristic>
        <characteristic name="Ra" typeId="bc43-4f04-cc0b-d5a1">-</characteristic>
        <characteristic name="Ar" typeId="cbb8-58cf-daa7-a95a">7+</characteristic>
        <characteristic name="Ne" typeId="945e-25f3-67f4-228d">6+</characteristic>
        <characteristic name="Wn" typeId="0d6a-358f-3234-b66b">1</characteristic>
        <characteristic name="H" typeId="492c-c3ca-0905-99c9">2</characteristic>
        <characteristic name="Ranged" typeId="0a27-40ac-5701-ef13">-</characteristic>
