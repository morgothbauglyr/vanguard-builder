    <profile name="HARD AS NAILS" id="8e77-b3d0-8e7e-ed4b" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">2</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">Use this ability when the Golem fails any Armour Rolls.</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">Re-roll all the dice that failed. Any that score a 5+ will save a wound (Exploding 8s! do not apply to any dice re-rolled using this ability).</characteristic>
      </characteristics>
    </profile>
    <profile name="Lesser Obsidian Golem" id="ceb8-7a03-6bab-9a85" hidden="false" typeId="8146-3b99-e6f9-d0a1" typeName=" Warband Member">
