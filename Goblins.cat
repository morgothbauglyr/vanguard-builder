    <profile name="Shrivel" id="2ec3-9f83-ea23-4704" hidden="false" typeId="33dc-fb92-76ea-f796" typeName="Spell">
      <characteristics>
        <characteristic name="Action" typeId="4e66-0225-3cc6-27c7">short</characteristic>
        <characteristic name="Range" typeId="c023-a997-9c10-c42c">9&quot;</characteristic>
        <characteristic name="Dice Roll" typeId="8297-1752-8ed2-7571">2D8</characteristic>
        <characteristic name="Effect" typeId="1a53-41d9-8d96-a949">For each hit scored, the target suffers a -1 modifier to any Melee or Ranged attack it makes until the end of the Round.</characteristic>
        <characteristic name="Rules" typeId="8b19-fa5a-3224-b8b5"/>
        <characteristic name="Rules Boosted" typeId="ed87-4c1b-85df-b365"/>
      </characteristics>
    </profile>
    <profile name="Shrivel (Boosted)" id="1160-6c16-629d-58a6" hidden="false" typeId="33dc-fb92-76ea-f796" typeName="Spell">
      <characteristics>
        <characteristic name="Action" typeId="4e66-0225-3cc6-27c7">long</characteristic>
        <characteristic name="Range" typeId="c023-a997-9c10-c42c">9&quot;</characteristic>
        <characteristic name="Dice Roll" typeId="8297-1752-8ed2-7571">3D8</characteristic>
        <characteristic name="Effect" typeId="1a53-41d9-8d96-a949">For each hit scored, the target suffers a -1 modifier to any Melee or Ranged attack it makes until the end of the Round.</characteristic>
        <characteristic name="Rules" typeId="8b19-fa5a-3224-b8b5"/>
        <characteristic name="Rules Boosted" typeId="ed87-4c1b-85df-b365"/>
      </characteristics>
    </profile>
    <profile name="Slink" id="21a3-7192-ca82-9ae8" hidden="false" typeId="33dc-fb92-76ea-f796" typeName="Spell">
      <characteristics>
        <characteristic name="Action" typeId="4e66-0225-3cc6-27c7">short</characteristic>
        <characteristic name="Range" typeId="c023-a997-9c10-c42c">6&quot;</characteristic>
        <characteristic name="Dice Roll" typeId="8297-1752-8ed2-7571">1D8</characteristic>
        <characteristic name="Effect" typeId="1a53-41d9-8d96-a949">Target a friendly GOBLIN model, with a -1 modifier on the roll. If a hit is  scored, instead of suffering a wound, the target model removes any Activation counter on it and can be activated again this Round in a later Turn.</characteristic>
        <characteristic name="Rules" typeId="8b19-fa5a-3224-b8b5"/>
        <characteristic name="Rules Boosted" typeId="ed87-4c1b-85df-b365"/>
      </characteristics>
    </profile>
