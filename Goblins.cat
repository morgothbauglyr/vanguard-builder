        <characteristic name="Rules" typeId="b478-b971-cc61-444f">Piercing (1), Reload</characteristic>
      </characteristics>
    </profile>
    <profile name="AGILE FEINT" id="c643-d8b3-2526-4d35" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">2</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">After this model has made a Melee attack and after any Retaliation.</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">The model may make a free Break Away action.</characteristic>
      </characteristics>
    </profile>
    <profile name="ALPHA HOWL!" id="cb6f-e1fe-fa1f-a7c8" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">2</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">When declaring a Group Assault Action</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">Magwa &amp; Jo&apos;os must the nominated group leader. All the members of the group have the Bloodlust special rule until the end of the turn.</characteristic>
      </characteristics>
    </profile>
    <profile name="CACKLE" id="b77c-7f80-1613-ad68" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">1</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">Use when the model activates</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">The model may cast the same spell twice this Turn if it has enough actions.</characteristic>
      </characteristics>
    </profile>
    <profile name="CRAFTY TACTICS" id="7a8d-6794-6e09-42ed" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">1</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">During any of your Turns if this model is not Fatigued.</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">Remove 1 Fatigue counter from a friendly model within 6&quot; of this model. This ability may be used once per round.</characteristic>
      </characteristics>
    </profile>
    <profile name="ESCAPE!" id="c281-7cda-b8db-9267" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">2</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">When an enemy model declares the intention to Engage this model</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">This model may elect to Escape! If it elects to Escape!, it moves before, and directly away from, the enemy model as far as possible with a free Walk action. It is then marked as Fatigued. If the enemy model can no longer reach this model to Engage it, it may perform a Walk action (if it hasn’t already) and then its activation is over. Escape! is limited to one use per Round for this model.</characteristic>
      </characteristics>
    </profile>
    <profile name="FLEE!" id="a03e-6bd5-70a6-fb38" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">1</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">When an enemy model declares the intention to Engage a GOBLIN model.</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">The GOBLIN model may elect to Flee unless it is already activated, Fatigued or Engaged. If the GOBLIN elects to FLEE, it moves before, and directly away from, the enemy model as far as possible with a free Walk action. It is then marked as Fatigued. If the enemy model can no longer reach the GOBLIN to Engage it, it may perform a Walk action (if it hasn’t already) and then its activation is over. This special ability is not limited to one use per Round.</characteristic>
      </characteristics>
    </profile>
    <profile name="HOWL!" id="68ab-a9f4-253d-258f" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">1</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">Use when the model activates or after it has finished its actions.</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">Any friendly, non-Fatigued and non-activated Mawbeasts within 6” of this model can immediately make a Walk action directly towards this model without being marked as activated. An individual Mawbeast can only Howl! once per Round.</characteristic>
      </characteristics>
    </profile>
    <profile name="I CAN SEE TIME!" id="8099-47ea-d06a-95f1" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">1</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">Use this ability when activating this model.</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">Once during this activation, after rolling dice during the first Cast action in this activation you may choose to re-roll all dice.</characteristic>
      </characteristics>
    </profile>
    <profile name="POISON BLADES" id="d656-0b16-b48b-3382" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">1</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">The model makes a Ranged Attack with their Throwing Knives, before rolling dice.</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">The attack has the Piercing (1) rule.</characteristic>
      </characteristics>
    </profile>
    <profile name="PUPPY YELP!" id="0c66-1163-93fb-9c3c" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">1</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">After a Ranged attack using the Mawpup Launcher has been resolved.</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">Any friendly, non-Fatigued and non-activated Mawbeasts within 6&quot; of the target can immediately make a Walk action directly towards the target without being marked as activated.</characteristic>
      </characteristics>
    </profile>
    <profile name="DODGY GRENADES" id="fcb3-1fd8-fe07-9a2e" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">X</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">When declaring a Ranged Attack Action.</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">Make a Ranged attack with the Dodgy Grenades. Before the attack is made, roll a single die and add (X) to the result. On a result of 8 or more, the grenade explodes before being thrown - the Banggit suffers 1 automatic hit with Piercing (X) and the ranged attack fails. Otherwise, the attack proceeds as normal
Dogdy Grenades Range 6”, Piercing (X), Area Effect (2” / 1D8 / Piercing (X))</characteristic>
      </characteristics>
    </profile>
    <profile name="Dodgy Grenades" id="a03e-59ee-5e9f-782a" hidden="false" typeId="3cda-8938-b7d6-58ab" typeName="Attack - Ranged">
      <characteristics>
        <characteristic name="Range" typeId="41f5-319f-6ccd-eaec">6&quot;</characteristic>
        <characteristic name="Dice" typeId="2088-497d-b499-8476"/>
        <characteristic name="Rules" typeId="b478-b971-cc61-444f">Piercing (X), Area Effect</characteristic>
      </characteristics>
    </profile>
    <profile name="DASTARDLY TRAPS" id="15dc-72da-9b22-18d6" hidden="false" typeId="39ba-3647-6510-7709" typeName="Ability">
      <characteristics>
        <characteristic name="Power Cost" typeId="1bf9-e90f-6415-1697">-</characteristic>
        <characteristic name="Timing" typeId="4502-0f40-9d79-bc93">When declaring a Short Action</characteristic>
        <characteristic name="Effect" typeId="b9cf-1e25-5292-ae34">As a short action, this model may place a 25mm trap marker anywhere within 6&quot; in Open Ground or Difficult Terrain but not within 6&quot; of another trap marker or within 3&quot; of an enemy model. When an enemy model moves within 3&quot; of a trap marker, it immediately suffers a 2D8 Ra 5+ attack with Piercing (1). The target model is marked as Fatigued if it suffers any wounds. The trap marker is then removed. A warband can have a maximum of 4 Dastardly Trap markers on the table at any time.</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
  <sharedRules>
    <rule name="Dodgy Grenades" id="3337-2f17-f0ea-8545" hidden="false">
      <description>Using the Ability **Dodgy Grenades** is required to use this attack.</description>
    </rule>
    <rule name="Inspiring ( Sneaks Only )" id="03ff-213e-65cd-5787" hidden="false"/>
    <rule name="Smokebombs" id="0411-af6c-8d01-c995" hidden="false">
      <description>This model can always Break Away without having to make any Armour rolls.</description>
    </rule>
    <rule name="Eye in the Sky" id="183e-368f-a5b5-79f6" hidden="false">
      <description>Friendly models (excluding the Winggit itself) making Ranged attacks against enemy models that are within 9&quot; of the Winggit always have clear LOS unless LOS is blocked.</description>
    </rule>
    <rule name="Rabble Rouser" id="8a2f-0ad0-f85c-fc9a" hidden="false">
      <description>While within 6&quot; of this model, friendly GOBLIN models (not including the Blaggit) have their Nerve value improved by 1 (e.g. +6 becomes 5+ ).</description>
    </rule>
    <rule name="Pup and Over" id="a2e4-0d9d-e4de-44a5" hidden="false">
      <description>This model has the Marksman special rule when making a Ranged attack against a target that is within 9&quot; of a friendly Winggit.</description>
    </rule>
    <rule name="Pack Leader" id="5f0c-936a-2cf6-fb0b" hidden="false">
      <description>You may take up two additional Mawbeast units in your Warband beyond those normally allowed in the Warband selection rules.</description>
    </rule>
    <rule name="Dastardly Traps" id="3b26-96e1-2ad1-d070" hidden="false">
      <description>Using the Ability **Dastardly Traps** is required to use this attack.</description>
    </rule>
  </sharedRules>
